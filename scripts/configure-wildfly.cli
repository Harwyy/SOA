/socket-binding-group=standard-sockets/socket-binding=http:write-attribute(name=port,value=8080)
/subsystem=undertow/server=default-server/http-listener=default:write-attribute(name=enabled,value=true)
/subsystem=remoting/http-connector=http-remoting-connector:write-attribute(name=connector-ref,value=default)
:reload
